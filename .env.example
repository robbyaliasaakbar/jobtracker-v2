# JobTracker v2 — contoh env tingkat repo (tidak ada secret di sini).
#
# Env jalanannya ada per-service:
#   backend-api/.env   -> salin dari backend-api/.env.example (DB, AUTH_URL, PORT)
#   frontend/.env      -> salin dari frontend/.env.example (opsional, mode dev)
#   frontend/.env.production sudah tracked: URL funnel + base Pages.
#
# Test CI / lokal (opsional; kalau kosong test pakai <DB_NAME>_test):
# TEST_DATABASE_URL=postgres://user:pass@localhost:5432/jobtracker_v2_test
