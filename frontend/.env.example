# JobTracker v2 — frontend (Vite, port dev 7013)
# Salin ke `.env` lalu isi. Kosongkan untuk mode lokal (fallback otomatis
# ke hostname yang sama, port auth 7002 / API 7012).

# URL auth pusat FROZEN. Di belakang Caddy pakai suffix /auth
# (Caddy strip prefix /auth sebelum proxy ke :7002).
VITE_AUTH_URL=http://localhost:7002

# URL API lamaran baru (Caddy: /api/* -> :7012).
VITE_API_URL=http://localhost:7012

# Base path build (GitHub Pages): di-set di .env.production (VITE_BASE=/jobtracker/).
# Dev lokal: kosongkan — server dev jalan di root :7013.
