# JobTracker v2 — backend-api (port 7012)
# Salin ke `.env` lalu isi. File .env TIDAK di-commit (lihat .gitignore).

# --- Koneksi Postgres (pakai salah satu cara) ---
# Cara A: bagian-bagian (mudah dioverride Docker: cukup ganti DB_HOST)
DB_USER=postgres
DB_PASSWORD=ISI_PASSWORD_POSTGRES_LOKAL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobtracker_v2

# Cara B: URL penuh (menang atas Cara A). Dipakai CI / test.
# DATABASE_URL=postgres://user:pass@host:5432/jobtracker_v2

# --- Server ---
PORT=7012

# --- Auth pusat FROZEN (jangan diubah isinya, cuma dibaca via GET /api/me) ---
AUTH_URL=http://127.0.0.1:7002

# --- CORS: origin yang boleh memanggil API (dipisah koma) ---
ALLOWED_ORIGIN=http://localhost:7013,http://127.0.0.1:7013,https://robbyaliasaakbar.github.io

# --- Cutover SQLite -> Postgres (sekali jalan) ---
# SQLITE_PATH=/path/ke/auth.db

# --- Test (opsional; kalau kosong, test pakai <DB_NAME>_test) ---
# TEST_DATABASE_URL=postgres://user:pass@host:5432/jobtracker_v2_test
